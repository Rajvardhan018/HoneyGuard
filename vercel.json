{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/honeypots",
      "destination": "/index.html"
    },
    {
      "source": "/attacks",
      "destination": "/index.html"
    },
    {
      "source": "/threat-intel",
      "destination": "/index.html"
    },
    {
      "source": "/mitre",
      "destination": "/index.html"
    },
    {
      "source": "/incidents",
      "destination": "/index.html"
    },
    {
      "source": "/response",
      "destination": "/index.html"
    },
    {
      "source": "/lab",
      "destination": "/index.html"
    },
    {
      "source": "/architecture",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|assets|favicon.png).*)",
      "destination": "/index.html"
    }
  ]
}
