{
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/honeypots",
      "destination": "/index.html"
    },
    {
      "source": "/attacks",
      "destination": "/index.html"
    },
    {
      "source": "/threat-intel",
      "destination": "/index.html"
    },
    {
      "source": "/mitre",
      "destination": "/index.html"
    },
    {
      "source": "/incidents",
      "destination": "/index.html"
    },
    {
      "source": "/response",
      "destination": "/index.html"
    },
    {
      "source": "/lab",
      "destination": "/index.html"
    },
    {
      "source": "/architecture",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|assets|favicon.png).*)",
      "destination": "/index.html"
    }
  ]
}
